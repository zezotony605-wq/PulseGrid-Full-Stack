POSTGRES_R2DBC_URL=r2dbc:postgresql://localhost:5432/pulsegrid
POSTGRES_USER=pulsegrid
POSTGRES_PASSWORD=pulsegrid
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=pulsegrid
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TELEMETRY_TOPIC=pulsegrid.telemetry.v1
KAFKA_CONSUMER_GROUP=pulsegrid-storage-v1
KAFKA_CONSUMER_CONCURRENCY=3
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=pulsegrid
DEVICE_SHARED_SECRET=replace-with-a-unique-device-provisioning-secret
DASHBOARD_ORIGINS=http://localhost:3000
GRAFANA_ADMIN_PASSWORD=replace-me

# Dashboard (baked into the client bundle at build time)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Go alert evaluator
ALERT_POLL_INTERVAL=5s
ALERT_LISTEN_ADDR=:8090
